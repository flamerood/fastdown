{
  "manifest_version": 3,
  "name": "Fastdown · Tarayıcı bağlantısı",
  "version": "1.7.0",
  "description": "İndirmeleri Fastdown'a aktarır; video ve resimlerin üzerinde indirme düğmesi gösterir.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["downloads", "nativeMessaging", "contextMenus", "storage", "webRequest", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Fastdown ile indir", "default_popup": "popup.html", "default_icon": { "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["source-parser.js", "page-observer.js"], "run_at": "document_start", "world": "MAIN", "all_frames": true },
    { "matches": ["http://*/*", "https://*/*"], "js": ["media-quality.js", "source-parser.js", "video-page.js", "overlay-rules.js", "media-filter.js", "content.js"], "run_at": "document_idle", "all_frames": true }
  ]
}
